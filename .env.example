# Opções não sensíveis. A aplicação lê o ambiente do processo.
# Este arquivo é uma referência; não é carregado automaticamente.
SESSAO_INATIVIDADE_MS=1800000
SESSAO_DURACAO_MAXIMA_MS=28800000
LOGIN_POR_JANELA=30
LOGIN_POR_PROCESSO=120
LOGIN_SIMULTANEOS=4

# Limiar demonstrativo de alerta de chuva, em percentual (0 a 100).
CLIMA_LIMIAR_PERCENTUAL=60

# Zero escolhe uma porta livre para a API em loopback.
API_RELATORIOS_PORTA=0

# Telegram: simulado ou telegram. Envio automático exige true explícito.
MENSAGENS_MODO=simulado
MENSAGENS_AUTOMATICAS=false
TELEGRAM_BOT_TOKEN=
