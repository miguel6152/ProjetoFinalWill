{
  "name": "sistema-academia",
  "version": "0.1.1",
  "private": true,
  "description": "Sistema desktop de gestão da academia",
  "main": "dist/src/main/Aplicacao.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test:integracao-julio": "npm run build && electron dist/tools/VerificarIntegracaoJulio.js",
    "test:api-relatorios": "npm run build && electron dist/tools/VerificarApiRelatorios.js",
    "test:clima": "npm run build && node dist/tools/VerificarClima.js && electron dist/tools/VerificarClimaIpc.js && electron dist/tools/VerificarInterfaceClima.js",
    "test:avaliacoes": "npm run build && electron dist/tools/VerificarAvaliacoes.js && electron dist/tools/VerificarInterfaceAvaliacoes.js",
    "test:inscricoes": "npm run build && electron dist/tools/VerificarInscricoes.js",
    "test:aulas": "npm run build && electron dist/tools/VerificarAulas.js && electron dist/tools/VerificarInterfaceAulas.js",
    "test:instrutores": "npm run build && electron dist/tools/VerificarInstrutores.js && electron dist/tools/VerificarInterfaceInstrutores.js",
    "test:entregas": "npm run build && node dist/tools/VerificarEntregas.js",
    "test:avisos": "npm run build && node dist/tools/VerificarAvisos.js",
    "test:inadimplencia": "npm run build && node dist/tools/VerificarInadimplencia.js",
    "test:pagamentos": "npm run build && electron dist/tools/VerificarPagamentos.js",
    "test:matriculas": "npm run build && electron dist/tools/VerificarMatriculas.js",
    "test:planos": "npm run build && electron dist/tools/VerificarPlanos.js",
    "test:planos-interface": "npm run build && electron dist/tools/VerificarInterfacePlanos.js",
    "test:viacep": "npm run build && node dist/tools/VerificarViaCep.js && electron dist/tools/VerificarViaCepIpc.js",
    "test:viacep-interface": "npm run build && electron dist/tools/VerificarViaCepInterface.js",
    "test:alunos": "npm run build && electron dist/tools/VerificarAlunos.js",
    "test:alunos-interface": "npm run build && electron dist/tools/VerificarInterfaceAlunos.js",
    "setup:electron": "install-electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build": "tsc && tsc -p tsconfig.renderer.json && node dist/tools/CopiarAssets.js",
    "rebuild:native": "electron-builder install-app-deps",
    "dist:dir:win:x64": "npm run build && electron-builder --dir --win --x64",
    "dist:win:x64": "npm run build && electron-builder --win nsis --x64",
    "demo:seed": "npm run build && electron dist/tools/PrepararDemonstracao.js",
    "demo": "npm run build && electron . --demo",
    "test:demo": "npm run build && electron dist/tools/VerificarDemonstracao.js",
    "test:demo:empacotado": "npm run build && node dist/tools/VerificarPacoteDemonstracao.js",
    "start": "electron .",
    "dev": "npm run build && npm start",
    "test:infra": "npm run build && electron dist/tools/VerificarInfraestrutura.js",
    "test:banco": "npm run build && electron dist/tools/VerificarBanco.js",
    "test:contratos": "npm run build && node dist/tools/VerificarContratosRepository.js",
    "test:leituras": "npm run build && electron dist/tools/VerificarLeiturasRepository.js",
    "test:escritas": "npm run build && electron dist/tools/VerificarEscritasRepository.js",
    "test:auth-contratos": "npm run build && node dist/tools/VerificarContratosAutenticacao.js && node dist/tools/VerificarDependenciasAutenticacao.js",
    "test:auth": "npm run build && node dist/tools/VerificarAutenticacao.js",
    "test:auth-banco": "npm run build && electron dist/tools/VerificarAutenticacaoBanco.js",
    "test:sessoes": "npm run build && node dist/tools/VerificarSessoes.js",
    "test:auth-ipc": "npm run build && electron dist/tools/VerificarAutenticacaoIpc.js",
    "test:auth-seguranca": "npm run build && electron dist/tools/VerificarSegurancaAutenticacao.js",
    "test:usuarios": "npm run build && electron dist/tools/VerificarUsuarios.js",
    "test:inicializacao": "npm run build && electron dist/tools/VerificarProvisionamento.js",
    "test:politicas": "npm run build && electron dist/tools/VerificarPoliticasSeguranca.js",
    "test:interface": "npm run build && electron dist/tools/VerificarInterfaceAdministrativa.js"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "argon2": "0.45.2",
    "better-sqlite3": "13.1.1",
    "express": "^5.3.0",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "better-sqlite3@13.1.1": true,
    "argon2@0.45.2": true
  },
  "build": {
    "appId": "br.com.projetofinalwill.sistemaacademia",
    "productName": "Sistema de Academia",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/tools/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/argon2/**"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "installer/windows.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
